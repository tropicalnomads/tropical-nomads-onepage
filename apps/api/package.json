{
  "name": "tropical-nomads-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local read-only Hono API for the published JSON. No public URL.",
  "exports": {
    ".": "./src/app.ts",
    "./accounts": "./src/accounts.ts",
    "./account-erasure": "./src/account-erasure.ts",
    "./payments": "./src/payments.ts",
    "./tickets": "./src/tickets.ts",
    "./check-in": "./src/check-in.ts",
    "./parties": "./src/parties.ts",
    "./artists": "./src/artists.ts"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "lint": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1164.0",
    "@aws-sdk/client-s3": "3.1164.0",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17",
    "pg": "8.13.3",
    "tropical-nomads-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.11.11",
    "typescript": "^6.0.3"
  }
}
