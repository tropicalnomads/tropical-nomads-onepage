{
  "name": "tropical-nomads-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local read-only Hono API for the published JSON. No public URL.",
  "exports": {
    ".": "./src/app.ts",
    "./accounts": "./src/accounts.ts",
    "./payments": "./src/payments.ts"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/main.ts",
    "lint": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17",
    "pg": "8.13.3",
    "tropical-nomads-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "8.11.11",
    "typescript": "^6.0.3"
  }
}
