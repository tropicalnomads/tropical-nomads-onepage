# Production environment. Loaded by apps/web when NODE_ENV=production.
# API_BASE_URL is the internet-facing load balancer for the ECS service tropical-nomads-api.
# Do not put a pool id, client id, session secret, account id, or database password here.

# Web (Amplify: tropical-nomads-web)
AMPLIFY_MONOREPO_APP_ROOT=apps/web
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_HOSTED_DOMAIN=
COGNITO_REDIRECT_URI=
COGNITO_GOOGLE=false
COGNITO_APPLE=false
INITIAL_ADMIN_SUB=
ACCOUNT_SESSION_SECRET=
API_BASE_URL=https://tropical-nomads-api-244827574.eu-central-1.elb.amazonaws.com
NEXT_TELEMETRY_DISABLED=1

# API (ECS task tropical-nomads-api). DB_USER and DB_PASSWORD come from Secrets Manager.
API_HOSTNAME=0.0.0.0
API_PORT=8787
TROPICAL_NOMADS_OPERATIONAL_ROOT=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# One-pager. Amplify sets AWS_COMMIT_ID when it has a commit.
AWS_COMMIT_ID=
GOABASE_REFRESH=0

# Frankfurt deploy and host status.
EXPECTED_AWS_ACCOUNT=
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1
