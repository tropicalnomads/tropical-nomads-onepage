# Dev template. Committed. Development loads .env, which uses this same local API.
# Do not put a real pool id, client id, session secret, account id, or database password here.

# Web
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_HOSTED_DOMAIN=
COGNITO_REDIRECT_URI=http://127.0.0.1:3000/account/callback
COGNITO_GOOGLE=false
COGNITO_APPLE=false
INITIAL_ADMIN_SUB=
ACCOUNT_SESSION_SECRET=
API_BASE_URL=http://127.0.0.1:8787
NEXT_TELEMETRY_DISABLED=1

# API. Loopback only. 0.0.0.0 belongs on the ECS task, not on a laptop.
API_HOSTNAME=127.0.0.1
API_PORT=8787
TROPICAL_NOMADS_OPERATIONAL_ROOT=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# One-pager
AWS_COMMIT_ID=
GOABASE_REFRESH=0

# Frankfurt deploy and host status.
EXPECTED_AWS_ACCOUNT=
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1
